NEAR_INTENTS_AGENT_API_URL=http://localhost:3000
# Partner API key from the partner portal (https://partners.near-intents.org); server-only
NEAR_INTENTS_AGENT_API_KEY=

# Optional: what receipt verification trusts. Defaults pin the production Agent API's log and witness.
# RECEIPT_LOG_ORIGIN=api.agentsonintents.com/log
# RECEIPT_LOG_URL=https://log.agentsonintents.com/
# RECEIPT_WITNESS_KEY=

DATABASE_URL=postgresql://near_intents_agent_demo:YOUR_PASSWORD@localhost:5435/near_intents_agent_demo

SECRET_ENCRYPTION_KEY=YOUR_SECRET_ENCRYPTION_KEY

BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET

NODE_ENV=development