{
  "name": "demo",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm db:migrate && next dev --port 3002",
    "build": "next build",
    "start": "next start --port ${PORT:-3002}",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env lib/db/migrate.mjs",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency 4 \"tests/integration/**/*.test.ts\"",
    "test:postgres": "node --import tsx --env-file-if-exists=tests/.env --test tests/postgres/demo-storage.test.ts",
    "test:http": "pnpm build && node --import tsx --env-file-if-exists=tests/.env --test tests/e2e/http.test.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "docker:up": "docker compose up -d --wait database",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/cimd": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@better-auth/mcp": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@better-auth/passkey": "1.7.4",
    "@hot-labs/near-connect": "0.11.4",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/server": "2.0.0",
    "@near-intents-agent-api/sdk": "^0.4.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.2",
    "@tanstack/react-query": "^5.102.8",
    "better-auth": "1.7.4",
    "better-near-auth": "^1.10.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "reflect-metadata": "0.2.2",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.8",
    "wagmi": "^2.16.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@electric-sql/pglite": "^0.3.14",
    "@hookform/resolvers": "^5.9.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "^2.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.4",
    "esbuild": "0.28.2",
    "near-api-js": "7.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  }
}
