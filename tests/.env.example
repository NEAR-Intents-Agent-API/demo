# Real PostgreSQL integration only. Use a database separate from local development.
# Start it with `pnpm docker:up`, create the test database, then run `pnpm test:postgres`.
# `pnpm test:http` creates and drops its own database under this server, so the user needs CREATEDB.
TEST_DEMO_DATABASE_URL=postgresql://near_intents_agent_demo:near_intents_agent_demo@localhost:5435/near_intents_agent_demo_test
